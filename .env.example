# Keep empty: Vite proxies /api to the local API on http://127.0.0.1:8787.
# Run npm run api:dev and npm run dev in separate terminals.
# An absolute URL is optional for development only; production always uses /api
# on the same domain as the website and ignores this variable.
VITE_API_URL=
# npm run dev:mock enables local public demo data and simulated form sends.
# Keep false for real API development; production always requests the API.
VITE_USE_MOCK_DATA=false

VITE_PHONE_MAKS=+7 (999) 123-45-67
VITE_PHONE_VLAD=+7 (999) 765-43-21
VITE_PHONE_HREF=tel:+79991234567
# WhatsApp: digits only; Telegram: username without @ or URL prefix.
VITE_WHATSAPP_MAKS=79991234567
VITE_WHATSAPP_VLAD=79997654321
VITE_TELEGRAM_MAKS=your_username
VITE_TELEGRAM_VLAD=your_username
VITE_CONTACT_EMAIL=hello@example.com
