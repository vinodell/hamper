# Copy to .env.server in the application root (outside public/).
# Generate the password hash using node scripts/create-password-hash.mjs.
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=
# Generate a random secret, e.g. node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
PUBLIC_ORIGIN=https://example.ru

# Optional Telegram delivery. Set both values; inquiries always remain in admin Journal.
# Never expose these through VITE_ variables or put .env.server inside public/.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# This must remain outside PUBLIC_DIR. Keep it on persistent local storage.
DATABASE_PATH=./private/data.sqlite
# Development build: ./dist. Hostland release: ./public.
PUBLIC_DIR=./dist
HOST=127.0.0.1
PORT=8787
