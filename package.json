{
  "name": "five-hills-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK_DATA=true vite --config mock/vite.config.ts --host localhost",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json --noEmit false",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "preview": "npm run build && npm start",
    "api:dev": "npm run build:server && node --watch --env-file-if-exists=.env.server server.js",
    "start": "node --env-file-if-exists=.env.server server.js",
    "server:typecheck": "tsc -p tsconfig.server.json",
    "db:migrate": "node --env-file-if-exists=.env.server build/server/cli.js migrate",
    "db:import": "node --env-file-if-exists=.env.server build/server/cli.js import-d1",
    "db:backup": "node --env-file-if-exists=.env.server build/server/cli.js backup",
    "package:hostland": "node scripts/package-hostland.mjs",
    "typecheck": "tsc -b",
    "test:auth": "node --test scripts/admin-auth.test.mjs scripts/frontend-auth.test.mjs",
    "test:data": "node --test scripts/data.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-sales.mjs",
    "test:browser:location": "node scripts/browser-location.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
