{
  "name": "five-hills-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK_DATA=true vite --config mock/vite.config.ts --host localhost",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "preview": "npm run build && wrangler dev",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:typecheck": "tsc -p tsconfig.worker.json",
    "typecheck": "tsc -b",
    "test:auth": "node --test scripts/admin-auth.test.mjs scripts/frontend-auth.test.mjs",
    "test:data": "node --test scripts/data.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node scripts/browser-sales.mjs",
    "test:browser:location": "node scripts/browser-location.mjs",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
